# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so

# === Virtual environments ===
.venv/
venv/
env/
ENV/

# === Distribution / packaging ===
build/
dist/
*.egg-info/
*.egg

# === Testing and coverage ===
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# === Type checkers and linters ===
.mypy_cache/
.ruff_cache/

# === IDEs and editors ===
.vscode/
.idea/
*.swp
*.swo
*~

# === OS metadata ===
.DS_Store
Thumbs.db
desktop.ini

# === Logs and runtime artifacts ===
*.log
logs/


# === Environment files (secrets) ===
# Never commit real .env files. .env.example is the committed template.
.env
.env.local
.env.*.local

# === Credentials and keys (belt-and-braces) ===
*.pem
*.key
credentials
aws-credentials
aws-config

# === Node (if frontend ever uses npm) ===
node_modules/
npm-debug.log

# === Project-specific ===
*.bak
*.tmp
local_*/
*.exe

# === Claude Code handover doc — source of truth, kept outside git ===
CLAUDE_HANDOVER*.md

# === Client-confidential mapping files — never committed ===
# A confidential client's internal control catalogue belongs to that
# business, not this repo. Keep it locally for real, correctly-scoped
# scans; app/mappings/loader.py tolerates its absence everywhere else.
backend/app/mappings/confidential_controls.json

# === Evidence reports produced by scripts/run_scheduled_audit.py ===
# Output of a real, potentially client-scoped scan — never committed.
# In CI this is uploaded as a workflow artifact instead, not to git.
backend/evidence-report.json
backend/*.evidence-report.json
